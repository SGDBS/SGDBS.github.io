<%
/*
 * Parameters (pass via partial locals):
 *   catName     – category name string to look up in site.categories
 *   activeSource – current post's source path for highlight/auto-expand ('' on category pages)
 */
var _catName      = (typeof catName      !== 'undefined' ? catName      : '') || '';
var _activeSource = ((typeof activeSource !== 'undefined' ? activeSource : '') || '').replace(/\\/g, '/');

if (_catName) {
    var catObj   = site.categories.findOne({name: _catName});
    var allPosts = catObj ? catObj.posts.sort('date').reverse().toArray() : [];

    /* folderConfigs injected by scripts/sidebar-folder-config.js */
    var folderConfigs = site.sidebarFolderConfigs || {};

    /* ── build two-level tree ──
       source path: _posts/<CatFolder>/<L1>/<L2>?/file.md
    */
    var tree      = {};
    var treeOrder = [];

    allPosts.forEach(function(p) {
        var src      = (p.source || '').replace(/\\/g, '/');
        var parts    = src.split('/');
        var dirParts = parts.slice(0, -1);

        var L1key = dirParts.length >= 3 ? dirParts[2] : '一般';
        var L1rel = dirParts.length >= 3 ? dirParts.slice(1, 3).join('/') : (dirParts[1] || '');

        if (!tree[L1key]) {
            tree[L1key] = { relPath: L1rel, subgroups: {}, sgOrder: [], posts: [] };
            treeOrder.push(L1key);
        }

        if (dirParts.length >= 4) {
            var L2key = dirParts[3];
            var L2rel = dirParts.slice(1, 4).join('/');
            if (!tree[L1key].subgroups[L2key]) {
                tree[L1key].subgroups[L2key] = { relPath: L2rel, posts: [] };
                tree[L1key].sgOrder.push(L2key);
            }
            tree[L1key].subgroups[L2key].posts.push(p);
        } else {
            tree[L1key].posts.push(p);
        }
    });

    /* ── sort: Chapter N numerically, others by post count desc ── */
    var chapterRe = /Chapter\s*(\d+)[.\-]?(\d*)/i;
    function chapterCmp(a, b, sizeFn) {
        var ma = a.match(chapterRe), mb = b.match(chapterRe);
        if (ma && mb) {
            var d = parseInt(ma[1]) - parseInt(mb[1]);
            return d !== 0 ? d : parseInt(ma[2] || 0) - parseInt(mb[2] || 0);
        }
        return sizeFn(b) - sizeFn(a);
    }

    /* ── compute category folder name (parts[1] of any post's source) ── */
    var catFolder = '';
    if (allPosts.length > 0) {
        var _fp0 = (allPosts[0].source || '').replace(/\\/g, '/').split('/');
        catFolder = _fp0.length >= 2 ? _fp0[1] : _catName;
    }

    /* ── sort sub-folder keys by parent config.json's `order` array,
          falling back to a comparator when not listed / no order field. ── */
    function applyFolderOrderConfig(folderKeys, parentCfg, fallbackCmp) {
        var orderArr = (parentCfg && Array.isArray(parentCfg.order)) ? parentCfg.order : null;
        if (!orderArr || orderArr.length === 0) {
            return folderKeys.slice().sort(fallbackCmp);
        }
        var orderMap = {};
        orderArr.forEach(function(name, idx) { orderMap[String(name)] = idx; });
        return folderKeys.slice().sort(function(a, b) {
            var ia = orderMap.hasOwnProperty(a) ? orderMap[a] : Infinity;
            var ib = orderMap.hasOwnProperty(b) ? orderMap[b] : Infinity;
            if (ia !== ib) return ia - ib;
            return fallbackCmp(a, b);
        });
    }

    var l1FallbackCmp = function(a, b) {
        var sizeA = tree[a].posts.length + tree[a].sgOrder.reduce(function(s,k){ return s + tree[a].subgroups[k].posts.length; }, 0);
        var sizeB = tree[b].posts.length + tree[b].sgOrder.reduce(function(s,k){ return s + tree[b].subgroups[k].posts.length; }, 0);
        return chapterCmp(a, b, function(k){ return k === a ? sizeA : sizeB; });
    };
    treeOrder = applyFolderOrderConfig(treeOrder, folderConfigs[catFolder], l1FallbackCmp);

    /* ── apply per-folder `order` from config.json ──
       cfg.order is an array of post filenames (without .md, .md tolerated).
       Listed posts come first in that order; unlisted posts follow in date-desc.
    */
    function applyOrderConfig(posts, cfg) {
        if (!cfg || !cfg.order || !Array.isArray(cfg.order) || cfg.order.length === 0) {
            return posts;
        }
        var orderMap = {};
        cfg.order.forEach(function(name, idx) {
            orderMap[String(name).replace(/\.md$/i, '')] = idx;
        });
        function basenameKey(p) {
            var src = (p.source || '').replace(/\\/g, '/');
            return src.split('/').pop().replace(/\.md$/i, '');
        }
        return posts.slice().sort(function(a, b) {
            var ia = orderMap.hasOwnProperty(basenameKey(a)) ? orderMap[basenameKey(a)] : Infinity;
            var ib = orderMap.hasOwnProperty(basenameKey(b)) ? orderMap[basenameKey(b)] : Infinity;
            if (ia !== ib) return ia - ib;
            return new Date(b.date) - new Date(a.date);
        });
    }

    /* ── assemble render data, tracking which groups contain the active post ── */
    var sidebarTree = treeOrder.map(function(L1key) {
        var node    = tree[L1key];
        var L1cfg   = folderConfigs[node.relPath] || {};
        var L1label = L1cfg.name || L1key;

        var l2FallbackCmp = function(a, b) {
            return chapterCmp(a, b, function(k){ return node.subgroups[k].posts.length; });
        };
        node.sgOrder = applyFolderOrderConfig(node.sgOrder, L1cfg, l2FallbackCmp);

        var isL1Active = false;

        var subgroups = node.sgOrder.map(function(L2key) {
            var sg      = node.subgroups[L2key];
            var L2cfg   = folderConfigs[sg.relPath] || {};
            var sgActive = _activeSource
                ? sg.posts.some(function(p){ return (p.source||'').replace(/\\/g,'/')===_activeSource; })
                : false;
            if (sgActive) isL1Active = true;
            return { label: L2cfg.name || L2key, posts: applyOrderConfig(sg.posts, L2cfg), isActive: sgActive };
        });

        if (!isL1Active && _activeSource) {
            isL1Active = node.posts.some(function(p){ return (p.source||'').replace(/\\/g,'/')===_activeSource; });
        }

        var total = node.posts.length + node.sgOrder.reduce(function(s,k){ return s + node.subgroups[k].posts.length; }, 0);
        return { label: L1label, posts: applyOrderConfig(node.posts, L1cfg), subgroups: subgroups, total: total, isActive: isL1Active };
    });

    /* ── sidebar top title: CatFolder's config.json name or folder name ── */
    var catFolderLabel = (folderConfigs[catFolder] && folderConfigs[catFolder].name)
        ? folderConfigs[catFolder].name
        : (catFolder || _catName);
%>

<nav class="category-sidebar">
    <div class="sidebar-title"><%= catFolderLabel %></div>
    <% sidebarTree.forEach(function(L1, i) { %>
    <div class="sidebar-group <%= L1.isActive ? '' : 'collapsed' %>" id="sg-<%= i %>">
        <div class="sidebar-group-title" onclick="toggleGroup('sg-<%= i %>')">
            <span class="sidebar-arrow">▼</span>
            <%= L1.label %>
            <span style="margin-left:auto;opacity:0.5;font-weight:400"><%= L1.total %></span>
        </div>
        <div class="sidebar-items">
            <% L1.subgroups.forEach(function(sg, j) { %>
            <div class="sidebar-subgroup <%= sg.isActive ? '' : 'collapsed' %>" id="sg-<%= i %>-<%= j %>">
                <div class="sidebar-subgroup-title" onclick="toggleGroup('sg-<%= i %>-<%= j %>')">
                    <span class="sidebar-arrow">▼</span>
                    <%= sg.label %>
                    <span style="margin-left:auto;opacity:0.5;font-weight:400"><%= sg.posts.length %></span>
                </div>
                <div class="sidebar-subitems">
                    <% sg.posts.forEach(function(p) { %>
                    <% var isActive = _activeSource && (p.source||'').replace(/\\/g,'/')===_activeSource; %>
                    <a class="sidebar-item sidebar-item--l2<%= isActive ? ' sidebar-item--active' : '' %>"
                       href="<%- url_for(p.path) %>" title="<%= p.title %>">
                        <%= p.title %>
                    </a>
                    <% }); %>
                </div>
            </div>
            <% }); %>
            <% L1.posts.forEach(function(p) { %>
            <% var isActive = _activeSource && (p.source||'').replace(/\\/g,'/')===_activeSource; %>
            <a class="sidebar-item<%= isActive ? ' sidebar-item--active' : '' %>"
               href="<%- url_for(p.path) %>" title="<%= p.title %>">
                <%= p.title %>
            </a>
            <% }); %>
        </div>
        <% if (i < sidebarTree.length - 1) { %>
        <div class="sidebar-divider"></div>
        <% } %>
    </div>
    <% }); %>
</nav>

<script>
function toggleGroup(id) {
    var el = document.getElementById(id);
    if (el) el.classList.toggle('collapsed');
}
</script>
<% } /* end if _catName */ %>
