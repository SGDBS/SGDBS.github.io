<%
var folderConfigs = site.sidebarFolderConfigs || {};
var posts = page.posts ? page.posts.toArray() : [];
var catFolder = '';
if (posts.length > 0) {
    var firstParts = (posts[0].source || '').replace(/\\/g, '/').split('/');
    catFolder = firstParts.length >= 2 ? firstParts[1] : page.category;
}
var catCfg = folderConfigs[catFolder] || {};
var catTitle = catCfg.name || page.category;

function naturalCmp(a, b) {
    return String(a).localeCompare(String(b), 'zh-Hans-CN', { numeric: true, sensitivity: 'base' });
}

function postSortKey(p) {
    var src = (p.source || '').replace(/\\/g, '/');
    return src.split('/').pop().replace(/\.md$/i, '');
}

function postOrderKeys(p) {
    var src = (p.source || '').replace(/\\/g, '/');
    var file = src.split('/').pop();
    var base = file.replace(/\.md$/i, '');
    return [base, file, p.slug, p.title]
        .filter(function(v) { return v !== undefined && v !== null && String(v).length > 0; })
        .map(function(v) { return String(v); });
}

function applyOrderConfig(items, cfg) {
    var hasOrder = cfg && Array.isArray(cfg.order) && cfg.order.length > 0;
    var orderMap = {};
    if (hasOrder) {
        cfg.order.forEach(function(name, idx) {
            var raw = String(name);
            orderMap[raw] = idx;
            orderMap[raw.replace(/\.md$/i, '')] = idx;
        });
    }
    function orderIndex(p) {
        if (!hasOrder) return Infinity;
        var keys = postOrderKeys(p);
        for (var i = 0; i < keys.length; i++) {
            if (orderMap.hasOwnProperty(keys[i])) return orderMap[keys[i]];
        }
        return Infinity;
    }
    return items.slice().sort(function(a, b) {
        var ia = orderIndex(a);
        var ib = orderIndex(b);
        if (ia !== ib) return ia - ib;
        return naturalCmp(postSortKey(a), postSortKey(b));
    });
}

function folderLabel(src) {
    var parts = (src || '').replace(/\\/g, '/').split('/');
    var dirParts = parts.slice(0, -1);
    if (dirParts.length < 3) return catTitle;
    var labels = [];
    var l1Rel = dirParts.slice(1, 3).join('/');
    var l1Cfg = folderConfigs[l1Rel] || {};
    labels.push(l1Cfg.name || dirParts[2]);
    if (dirParts.length >= 4) {
        var l2Rel = dirParts.slice(1, 4).join('/');
        var l2Cfg = folderConfigs[l2Rel] || {};
        labels.push(l2Cfg.name || dirParts[3]);
    }
    return labels.join(' / ');
}

var sortedPosts = applyOrderConfig(posts, catCfg);
%>

<div class="feishu-doc-page">
<%- partial('_partial/category-sidebar', {catName: page.category, activeSource: '', expandFirst: true}) %>

<header class="feishu-doc-topbar">
    <div class="feishu-doc-breadcrumb">
        <a href="<%- url_for('/') %>">YANG's Blog</a>
        <span>/</span>
        <a href="<%- url_for('/categories/') %>">Knowledge Base</a>
        <span>/</span>
        <span><%- catTitle %></span>
    </div>
    <div class="feishu-doc-updated"><%= sortedPosts.length %> 篇文章</div>
</header>

<main class="feishu-doc-main feishu-category-main content">
    <section class="category-doc-content">
        <header class="category-doc-header">
            <p class="category-doc-eyebrow">Category</p>
            <h1><%- catTitle %></h1>
            <p>按目录顺序浏览这个知识库下的文章。</p>
        </header>

        <div class="category-doc-list">
            <% sortedPosts.forEach(function(post) { %>
            <a class="category-doc-item" href="<%- url_for(post.path) %>">
                <span class="category-doc-icon"><i class="far fa-file-alt"></i></span>
                <span class="category-doc-mainline">
                    <span class="category-doc-title"><%= post.title %></span>
                    <span class="category-doc-meta">
                        <%= folderLabel(post.source) %>
                        <em><%= date(post.date, config.date_format) %></em>
                    </span>
                </span>
            </a>
            <% }); %>
        </div>
    </section>
</main>
</div>

<% if (page.total > 1) { %>
<%- partial('_partial/paging') %>
<% } %>
