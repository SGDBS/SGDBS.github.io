<%- partial('_partial/bg-cover') %>

<%
var hashCode = function (str) {
    if (!str && str.length === 0) { return 0; }
    var hash = 0;
    for (var i = 0, len = str.length; i < len; i++) {
        hash = ((hash << 5) - hash) + str.charCodeAt(i);
        hash |= 0;
    }
    return hash;
};

/* ── 侧边栏数据构建：从 site.categories 取全量文章，不受分页限制 ── */
var catObj = site.categories.findOne({name: page.category});
var allPosts = catObj
    ? catObj.posts.sort('date').reverse().toArray()
    : page.posts.toArray();

/* ── 按文件夹层级分组（source 路径的直属子文件夹作为组名） ── */
/* folderConfigs 由 scripts/sidebar-folder-config.js 注入，key 为相对 _posts 的路径 */
var folderConfigs = site.sidebarFolderConfigs || {};

var folderGroups   = {};   /* folderKey → [posts] */
var folderRelPaths = {};   /* folderKey → 相对 _posts 的路径，用于查 config.json */
var folderOrder    = [];

allPosts.forEach(function(p) {
    /* p.source: '_posts/ACM-ICPC/Dynamic_Programming/file.md' */
    var src      = (p.source || '').replace(/\\/g, '/');
    var parts    = src.split('/');           /* ['_posts','ACM-ICPC','Dynamic_Programming','file.md'] */
    var dirParts = parts.slice(0, -1);       /* 去掉文件名 */
    /* 分组键：直属子文件夹名（最后一级目录） */
    var key      = dirParts.length > 2 ? dirParts[dirParts.length - 1]
                 : dirParts.length > 1 ? dirParts[1]
                 : '一般';
    /* 相对 _posts 的路径，去掉开头的 '_posts' */
    var relPath  = dirParts.slice(1).join('/');   /* e.g. 'ACM-ICPC/Dynamic_Programming' */

    if (!folderGroups[key]) {
        folderGroups[key]   = [];
        folderRelPaths[key] = relPath;
        folderOrder.push(key);
    }
    folderGroups[key].push(p);
});

/* 章节类分组按章节号排序；其余按文章数降序 */
var chapterRe = /Chapter\s*(\d+)[.\-]?(\d*)/i;
var sidebarGroups = [];
folderOrder.sort(function(a, b) {
    var ma = a.match(chapterRe), mb = b.match(chapterRe);
    if (ma && mb) {
        var diff = parseInt(ma[1]) - parseInt(mb[1]);
        return diff !== 0 ? diff : parseInt(ma[2] || 0) - parseInt(mb[2] || 0);
    }
    return folderGroups[b].length - folderGroups[a].length;
});
folderOrder.forEach(function(k) {
    /* 优先用 config.json 中定义的 name，否则用文件夹名 */
    var cfg   = folderConfigs[folderRelPaths[k]] || {};
    var label = cfg.name || k;
    sidebarGroups.push({ label: label, posts: folderGroups[k] });
});
%>

<!-- 侧边栏：独立于 main，固定在视口最左侧 -->
<nav class="category-sidebar">
    <% sidebarGroups.forEach(function(group, gi) { %>
    <div class="sidebar-group" id="sg-<%= gi %>">
        <div class="sidebar-group-title" onclick="toggleSidebarGroup(<%= gi %>)">
            <span class="sidebar-arrow">▼</span>
            <%= group.label %>
            <span style="margin-left:auto;opacity:0.5;font-weight:400"><%= group.posts.length %></span>
        </div>
        <div class="sidebar-items">
            <% group.posts.forEach(function(p) { %>
            <a class="sidebar-item" href="<%- url_for(p.path) %>" title="<%= p.title %>">
                <%= p.title %>
            </a>
            <% }); %>
        </div>
        <% if (gi < sidebarGroups.length - 1) { %>
        <div class="sidebar-divider"></div>
        <% } %>
    </div>
    <% }); %>
</nav>

<main class="content">

    <%- partial('_widget/category-cloud') %>

    <article id="articles" class="container articles">
        <div class="row tags-posts">
            <% page.posts.sort('date').reverse().forEach(post => { %>
            <div class="article tag-post col s12 m6 l4" data-aos="zoom-in">
                <div class="card">
                    <a href="<%- url_for(post.path) %>">
                        <div class="card-image tag-image">
                            <% if (post.img) { %>
                            <img src="<%- url_for(post.img) %>" class="responsive-img" alt="<%= post.title %>">
                            <% } else { %>
                            <%
                                var featureimg = theme.featureImages[Math.abs(hashCode(post.title) % theme.featureImages.length)];
                            %>
                            <img src="<%- theme.jsDelivr.url %><%- url_for(featureimg) %>" class="responsive-img" alt="<%= post.title %>">
                            <% } %>
                            <span class="card-title"><%= post.title %></span>
                        </div>
                    </a>
                    <div class="card-content article-content">
                        <div class="publish-info">
                            <span class="publish-date">
                                <i class="far fa-clock fa-fw icon-date"></i><%= date(post.date, config.date_format) %>
                            </span>
                            <span class="publish-author">
                                <% if (post.categories && post.categories.length > 0) { %>
                                <i class="fas fa-bookmark fa-fw icon-category"></i>
                                <% post.categories.forEach(category => { %>
                                <a href="<%- url_for(category.path) %>" class="post-category">
                                    <%- category.name %>
                                </a>
                                <% }); %>
                                <% } else { %>
                                <i class="fas fa-user fa-fw"></i>
                                <%- config.author %>
                                <% } %>
                            </span>
                        </div>
                    </div>

                    <% if (post.tags && post.tags.length) { %>
                    <div class="card-action article-tags">
                        <% post.tags.forEach(tag => { %>
                        <a href="<%- url_for(tag.path) %>">
                            <span class="chip bg-color"><%= tag.name %></span>
                        </a>
                        <% }); %>
                    </div>
                    <% } %>
                </div>
            </div>
            <% }); %>
        </div>
    </article>

</main>

<% if (page.total > 1) { %>
<%- partial('_partial/paging') %>
<% } %>

<script>
function toggleSidebarGroup(idx) {
    var el = document.getElementById('sg-' + idx);
    if (el) el.classList.toggle('collapsed');
}
</script>
