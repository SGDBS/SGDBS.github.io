<% if (is_home() && page.current === 1) { %>
<%- partial('_partial/index-cover') %>
<div id="indexCard" class="index-card latest-dream-card">
    <div class="container">
        <div class="card">
            <div class="card-content">
                <%- partial('_widget/dream') %>
            </div>
        </div>
    </div>
</div>
<% } %>

<main class="content latest-home">
    <section class="latest-shell">
        <header class="latest-header">
            <div>
                <p class="latest-eyebrow">Latest Notes</p>
                <h1>YANG's Blog</h1>
                <p class="latest-subtitle">按时间整理的技术笔记、学习记录和工程实践。</p>
            </div>
            <a class="latest-kb-link" href="<%- url_for('/categories/') %>">
                <i class="fas fa-layer-group"></i>
                知识库
            </a>
        </header>

        <div class="latest-feed">
            <% page.posts.forEach(function(post) { %>
            <article class="latest-item">
                <a class="latest-title" href="<%- url_for(post.path) %>"><%= post.title %></a>
                <div class="latest-meta">
                    <span><i class="far fa-calendar"></i><%= date(post.date, config.date_format) %></span>
                    <% if (post.categories && post.categories.length > 0) { %>
                    <span>
                        <i class="fas fa-bookmark"></i>
                        <% post.categories.forEach(function(category, idx) { %>
                        <a href="<%- url_for(category.path) %>"><%- category.name %></a><%= idx < post.categories.length - 1 ? ' / ' : '' %>
                        <% }); %>
                    </span>
                    <% } %>
                </div>
                <p class="latest-summary">
                    <%- strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').substring(0, 150) %>
                </p>
                <% if (post.tags && post.tags.length > 0) { %>
                <div class="latest-tags">
                    <% post.tags.limit(5).forEach(function(tag) { %>
                    <a href="<%- url_for(tag.path) %>"><%= tag.name %></a>
                    <% }); %>
                </div>
                <% } %>
            </article>
            <% }); %>
        </div>
    </section>
</main>

<% if (page.total > 1) { %>
<%- partial('_partial/paging') %>
<% } %>
