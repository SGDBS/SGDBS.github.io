<% if (theme.verifyPassword.enable) { %>
<script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.crypto) %>"></script>
<script>
    (function() {
        let pwd = '<%- page.password %>';
        if (pwd && pwd.length > 0) {
            if (pwd !== CryptoJS.SHA256(prompt('<%- theme.verifyPassword.promptMessage %>')).toString(CryptoJS.enc.Hex)) {
                alert('<%- theme.verifyPassword.errorMessage %>');
                location.href = '<%- url_for("/")  %>';
            }
        }
    })();
</script>
<% } %>

<%
    var isTocEnable = theme.toc.enable && String(page.toc) !== 'false';
    var containerClass = isTocEnable ? 'feishu-doc-main post-container' : 'feishu-doc-main container';
    var _postCatName = (page.categories && page.categories.length > 0)
        ? page.categories.toArray()[0].name
        : '';
    var _postCategoryPath = (page.categories && page.categories.length > 0)
        ? page.categories.toArray()[0].path
        : '';
%>

<div class="feishu-doc-page">
<%- partial('_partial/category-sidebar', {catName: _postCatName, activeSource: page.source}) %>

<header class="feishu-doc-topbar">
    <div class="feishu-doc-breadcrumb">
        <a href="<%- url_for('/') %>">YANG's Blog</a>
        <% if (_postCatName) { %>
        <span>/</span>
        <a href="<%- url_for(_postCategoryPath) %>"><%- _postCatName %></a>
        <% } %>
        <span>/</span>
        <span><%- page.title %></span>
    </div>
    <div class="feishu-doc-updated">最近修改：<%- date(page.updated || page.date, 'YYYY-MM-DD HH:mm') %></div>
</header>

<main class="<%- containerClass %> content">

    <% if (isTocEnable) { %>
    <%- partial('_partial/post-detail-toc.ejs') %>
    <% } else { %>
    <%- partial('_partial/post-detail.ejs') %>
    <% } %>

</main>
</div>

<% if (theme.mathjax.enable && page.mathjax) { %>
<script type="text/x-mathjax-config">
    MathJax.Hub.Config({
        extensions: ["tex2jax.js"],
        tex2jax: { inlineMath: [['$','$'],['\\(','\\)']], processEscapes: true }
    });
</script>
<script src="<%- theme.mathjax.cdn %>"></script>
<% } %>
